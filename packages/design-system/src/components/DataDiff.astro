---
/**
 * DataDiff — field-by-field changes between two records. Client code updates it
 * with `el.compare(before, after)` or `el.changes = …`, or builds one with
 * `createDataDiff()` from lib/data-diff.
 */
import type { DataChange } from "../lib/data-values";
import { dataDiffTemplate } from "../lib/data-diff-template";
import { toHTML } from "../lib/ssr";
interface Props {
  label: string;
  changes: DataChange[];
  emptyMessage?: string;
  id?: string;
}
const { id, ...props } = Astro.props;
---

<sierra-data-diff id={id} data-props={JSON.stringify(props)} set:html={toHTML(dataDiffTemplate(props))} />

<script>
  import { defineDataDiff } from "../lib/data-diff";
  defineDataDiff();
</script>
