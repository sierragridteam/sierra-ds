---
import { formatDataValue, type DataChange } from "../lib/data-values";
interface Props {
  label: string;
  changes: DataChange[];
  emptyMessage?: string;
}
const { label, changes, emptyMessage = "No changes." } = Astro.props;
---

<section class="ds-diff" aria-label={label}>
  <div class="ds-diff-heading">
    <strong>{label}</strong>
    <span class="meta">
      {changes.length} {changes.length === 1 ? "change" : "changes"}
    </span>
  </div>
  {changes.length ? (
    <ol class="ds-diff-list">
      {changes.map((change) => (
        <li data-kind={change.kind}>
          <div class="ds-diff-field">
            <code>{change.path || "(root)"}</code>
            <span class="ds-data-note">{change.kind}</span>
          </div>
          <div class="ds-diff-values">
            {change.kind !== "added" && (
              <div>
                <span class="ds-data-note">Before</span>
                <pre>{formatDataValue(change.before)}</pre>
              </div>
            )}
            {change.kind !== "removed" && (
              <div>
                <span class="ds-data-note">After</span>
                <pre>{formatDataValue(change.after)}</pre>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <p class="ds-data-note">{emptyMessage}</p>
  )}
</section>
