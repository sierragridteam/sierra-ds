---
import { formatDataValue, type DataChange } from "../lib/data-values";
interface Props {
  label: string;
  changes: DataChange[];
  emptyMessage?: string;
}
const { label, changes, emptyMessage = "No changes." } = Astro.props;
---

<section class="ds-diff" aria-label={label}>
  <div class="ds-diff-heading">
    <strong>{label}</strong>
    <span class="meta">
      {changes.length} {changes.length === 1 ? "change" : "changes"}
    </span>
  </div>
  {changes.length ? (
    <ol class="ds-diff-list">
      {changes.map((change) => (
        <li data-kind={change.kind}>
          <code class="ds-diff-field">{change.path || "(root)"}</code>
          <div class="ds-diff-values">
            <span class="sr-only">
              {change.kind === "added"
                ? "Added: "
                : change.kind === "removed"
                  ? "Removed: "
                  : "Before: "}
            </span>
            {change.kind !== "added" && (
              <del class="ds-diff-before">{formatDataValue(change.before)}</del>
            )}{" "}
            <span class="ds-diff-arrow" aria-hidden="true">
              {change.kind === "added" ? "+" : "→"}
            </span>{" "}
            {change.kind === "changed" && <span class="sr-only">After: </span>}
            {change.kind === "removed" ? (
              <span class="ds-diff-removed">removed</span>
            ) : (
              <ins class="ds-diff-after">{formatDataValue(change.after)}</ins>
            )}
          </div>
        </li>
      ))}
    </ol>
  ) : (
    <p class="ds-data-note">{emptyMessage}</p>
  )}
</section>
