---
/**
 * Category bar chart: grouped, stacked or low–high range bars (weather trends).
 * Chart.js renders in the browser; set `props` (or `options`) on the element to
 * update it, or build one with `createBarChart()` from lib/charts.
 */
import ChartFrame from "./ChartFrame.astro";
import { barFrameProps } from "../lib/chart-frame";
import type { BarChartOptions } from "../lib/chart-model";
interface Props extends BarChartOptions {
  id?: string;
  class?: string;
}
const { id, class: className, ...options } = Astro.props;
---

<ChartFrame tag="sierra-bar-chart" id={id} class={className} options={options} {...barFrameProps(options)} />

<script>
  import { defineChartElements } from "../lib/charts";
  defineChartElements();
</script>
