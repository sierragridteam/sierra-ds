---
/**
 * Time-series line chart for telemetry. Chart.js renders in the browser; the
 * element exposes `props`/`options`, `series` and `appendPoints()` for live
 * updates. Client code can also use `createLineChart()` from lib/charts.
 */
import ChartFrame from "./ChartFrame.astro";
import { lineFrameProps } from "../lib/chart-frame";
import type { LineChartOptions } from "../lib/chart-model";
interface Props extends LineChartOptions {
  id?: string;
  class?: string;
}
const { id, class: className, ...options } = Astro.props;
---

<ChartFrame tag="sierra-line-chart" id={id} class={className} options={options} {...lineFrameProps(options)} />

<script>
  import { defineChartElements } from "../lib/charts";
  defineChartElements();
</script>
