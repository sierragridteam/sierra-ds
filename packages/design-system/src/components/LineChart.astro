---
/**
 * Time-series line chart for telemetry. Chart.js renders in the browser; the
 * element exposes `options`, `series` and `append()` for live updates.
 */
import ChartFrame from "./ChartFrame.astro";
import {
  DEFAULT_TIME_ZONE,
  buildLineModel,
  describeLine,
  lineTable,
  zoneLabel,
  type LineChartOptions,
} from "../lib/chart-model";
interface Props extends LineChartOptions {
  id?: string;
  class?: string;
}
const { id, class: className, ...options } = Astro.props;
const model = buildLineModel(options);
const meta = [options.unit && `Values in ${options.unit}`, `Times in ${zoneLabel(options.timeZone ?? DEFAULT_TIME_ZONE)}`]
  .filter(Boolean)
  .join(" · ");
---

<ChartFrame
  tag="sierra-line-chart"
  id={id}
  class={className}
  options={options}
  label={options.label}
  description={options.description}
  meta={meta}
  summary={describeLine(model)}
  table={lineTable(model)}
  empty={model.empty}
  series={model.series}
  height={options.height}
/>

<script>
  import { defineChartElements } from "../lib/charts";
  defineChartElements();
</script>
