---
/**
 * GeoJSONMap — features on a MapLibre map with an accessible feature list.
 * Client code sets `el.data`, `el.selected`, or builds one with `createGeoMap()`
 * from lib/geo-map. Requires maplibre-gl.
 */
import type { FeatureCollection, Geometry } from "geojson";
import { geoMapTemplate } from "../lib/geo-map-template";
import { toHTML } from "../lib/ssr";
interface Props {
  data: FeatureCollection<Geometry | null>;
  label: string;
  compact?: boolean;
  basemap?: boolean;
  /** Disable feature selection for a treatment overview; pan and zoom remain available. */
  selectable?: boolean;
  id?: string;
}
const { id, ...props } = Astro.props;
---

<sierra-geo-map
  id={id}
  class:list={["ds-geo-map", props.compact && "ds-map-compact"]}
  data-props={JSON.stringify(props)}
  set:html={toHTML(geoMapTemplate(props))}
/>

<script>
  import { defineGeoMap } from "../lib/geo-map";
  defineGeoMap();
</script>
