---
import CopyButton from "./CopyButton.astro";
interface Props {
  label: string;
  values: string[];
  previewCount?: number;
  emptyMessage?: string;
}
const {
  label,
  values,
  previewCount = 8,
  emptyMessage = "No identifiers supplied.",
} = Astro.props;
const limit = Math.max(1, Math.floor(previewCount));
---

<div class="ds-identifiers">
  <div class="ds-identifiers-head">
    <strong>
      {label} <span class="meta">({values.length})</span>
    </strong>
    {values.length > 0 && (
      <CopyButton value={values.join("\n")} label="Copy all identifiers" />
    )}
  </div>
  {values.length ? (
    <>
      <ul class="ds-identifier-list" aria-label={label}>
        {values.slice(0, limit).map((value) => (
          <li>
            <code>{value}</code>
            <CopyButton value={value} label={`Copy ${value}`} />
          </li>
        ))}
      </ul>
      {values.length > limit && (
        <details>
          <summary>Show {values.length - limit} more identifiers</summary>
          <ul class="ds-identifier-list">
            {values.slice(limit).map((value) => (
              <li>
                <code>{value}</code>
                <CopyButton value={value} label={`Copy ${value}`} />
              </li>
            ))}
          </ul>
        </details>
      )}
    </>
  ) : (
    <p class="ds-data-note">{emptyMessage}</p>
  )}
</div>
