---
/** Field — label + control + help/error. The control is slotted so any input type works. */
interface Props {
  label: string;
  for: string;
  help?: string;
  optional?: boolean;
  class?: string;
}
const { label, for: htmlFor, help, optional = false, class: cls } = Astro.props;
---

<div class:list={['field', cls]}>
  <label class="field__label" for={htmlFor}>
    {label}
    {optional && <span class="field__optional">(optional)</span>}
  </label>
  <slot />
  {help && (
    <p class="field__help" id={`${htmlFor}-help`}>
      {help}
    </p>
  )}
  <p class="field__error" id={`${htmlFor}-error`} hidden></p>
</div>
