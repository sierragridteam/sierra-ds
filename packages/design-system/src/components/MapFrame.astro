---
interface Props {
  label: string;
  caption?: string;
}
const { label, caption } = Astro.props;
---

<figure class="ds-map-frame" aria-label={label}>
  {Astro.slots.has("toolbar") && (
    <div class="ds-map-toolbar">
      <slot name="toolbar" />
    </div>
  )}
  <slot />
  <figcaption>
    {caption && <p>{caption}</p>}
    <slot name="legend" />
    <slot name="attribution" />
  </figcaption>
</figure>
