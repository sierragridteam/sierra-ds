---
/**
 * Select — single-choice popover listbox. Client code sets `el.options` and
 * `el.value` after data loads, or builds one with `createSelect()` from lib/select.
 */
import { selectTemplate, type SelectOption } from "../lib/select-template";
import { toHTML } from "../lib/ssr";
interface Props {
  id: string;
  options: SelectOption[];
  value?: string;
  name?: string;
  disabled?: boolean;
  "aria-describedby"?: string;
}
const { "aria-describedby": describedBy, ...rest } = Astro.props;
const props = { ...rest, describedBy };
---

<sierra-select data-props={JSON.stringify(props)} set:html={toHTML(selectTemplate(props))} />

<script>
  import { defineSelect } from "../lib/select";
  defineSelect();
</script>
