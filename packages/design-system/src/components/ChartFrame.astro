---
/**
 * Shared figure for LineChart, BarChart and TimeSeriesChart: caption, legend,
 * canvas and the data table, rendered from the same template client code uses.
 */
import type { ChartColor, ChartTable } from "../lib/chart-model";
import { chartFrameTemplate } from "../lib/chart-frame";
import { toHTML } from "../lib/ssr";
interface Props {
  tag: "sierra-line-chart" | "sierra-bar-chart" | "sierra-time-series";
  id?: string;
  class?: string;
  options: unknown;
  label: string;
  description?: string;
  meta: string;
  summary: string;
  table: ChartTable;
  empty: boolean;
  series: { id: string; label: string; color: ChartColor }[];
  height?: number;
}
const { tag: Tag, id, class: className, options, ...frame } = Astro.props;
---

<Tag id={id} class:list={["ds-chart", className]} data-options={JSON.stringify(options)} set:html={toHTML(chartFrameTemplate(frame))} />

<script>
  import { defineCopy } from "../lib/copy";
  defineCopy();
</script>
