---
/**
 * @deprecated Use LineChart. Kept API-compatible: the same props, the same
 * <sierra-time-series> element with `options` and `series`, UTC labels by
 * default. It now renders with the LineChart runtime, so it needs chart.js.
 */
import ChartFrame from "./ChartFrame.astro";
import { buildLineModel, describeLine, lineTable, zoneLabel } from "../lib/chart-model";
import { toLineOptions, type TimeSeriesChartOptions } from "../lib/time-series";
interface Props extends TimeSeriesChartOptions {
  id?: string;
}
const { id, ...options } = Astro.props;
const line = toLineOptions(options);
const model = buildLineModel(line);
---

<ChartFrame
  tag="sierra-time-series"
  id={id}
  options={options}
  label={options.label}
  description={options.description}
  meta={[options.unit && `Values in ${options.unit}`, `Times in ${zoneLabel(line.timeZone)}`].filter(Boolean).join(" · ")}
  summary={describeLine(model)}
  table={lineTable(model)}
  empty={model.empty}
  series={model.series}
/>

<script>
  import { defineChartElements } from "../lib/charts";
  defineChartElements();
</script>
