---
/**
 * Inline trend for stat tiles and table rows. Server-rendered SVG coloured by
 * tokens, so it themes without JavaScript. Set `values` on the element to update,
 * or use the `sparkline()` template from lib/ui inside a region.
 */
import type { SparklineOptions } from "../lib/chart-model";
import { toHTML } from "../lib/ssr";
import { sparkline } from "../lib/ui";
interface Props extends SparklineOptions {
  id?: string;
  class?: string;
}
---

<Fragment set:html={toHTML(sparkline(Astro.props))} />

<script>
  import { defineSparkline } from "../lib/sparkline";
  defineSparkline();
</script>
