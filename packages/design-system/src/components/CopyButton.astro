---
/**
 * CopyButton — copies `value` to the clipboard; the copy icon turns into a tick
 * while "Copied." is announced. Icon-only by default; pass `text` for a visible
 * label; the accessible `label` should start with that text (e.g. "Copy" /
 * "Copy table as Markdown"). Client code can replace the value with
 * `element.value = "…"`, or build one with `copyButton()` from lib/ui.
 */
import { toHTML } from "../lib/ssr";
import { copyButton } from "../lib/ui";
interface Props {
  value: string;
  label?: string;
  text?: string;
  class?: string;
}
const { value, ...options } = Astro.props;
---

<Fragment set:html={toHTML(copyButton(value, options))} />

<script>
  import { defineCopy } from "../lib/copy";
  defineCopy();
</script>
