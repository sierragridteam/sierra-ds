---
/**
 * ThemeScript — place once in <head>, before stylesheets render, to apply the
 * reader's stored colour theme before first paint (no light flash).
 *
 * Precedence: stored preference, then a valid data-theme already on <html>,
 * then `fallback`. Keep `storageKey` equal to the ThemeSwitcher's.
 *
 * Astro's ClientRouter replaces <html> attributes on each navigation, so the
 * current theme is copied onto the incoming document before the swap.
 */
import type { ThemePreference } from "../lib/theme";
interface Props {
  fallback?: ThemePreference;
  storageKey?: string;
}
const { fallback = "system", storageKey = "sierra-theme" } = Astro.props;
---

<script is:inline define:vars={{ fallback, storageKey }}>
  const valid = (value) =>
    value === "light" || value === "dark" || value === "system";
  let stored = null;
  try {
    stored = localStorage.getItem(storageKey);
  } catch {}
  const root = document.documentElement;
  root.dataset.theme = valid(stored)
    ? stored
    : valid(root.dataset.theme)
      ? root.dataset.theme
      : fallback;
  if (!window.__sierraThemeSwap) {
    window.__sierraThemeSwap = true;
    document.addEventListener("astro:before-swap", (event) => {
      const theme = document.documentElement.dataset.theme;
      if (valid(theme)) event.newDocument.documentElement.dataset.theme = theme;
    });
  }
</script>
