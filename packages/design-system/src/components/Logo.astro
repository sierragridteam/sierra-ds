---
/**
 * Logo — the S.I.E.R.R.A mark with a configurable site wordmark.
 * The mark is the main site's raster asset, placed on parchment, never recoloured.
 */
interface Props {
  href?: string;
  /** Site name shown beneath S.I.E.R.R.A and used in the home link label. */
  siteName?: string;
  height?: number;
  wordmark?: boolean;
  class?: string;
}
const {
  href = "/",
  siteName = "Members",
  height = 28,
  wordmark = true,
  class: cls,
} = Astro.props;
const width = Math.round((height * 271) / 154);
---

<a
  class:list={["logo", cls]}
  href={href}
  aria-label={["S.I.E.R.R.A", siteName, "home"].filter(Boolean).join(" ")}
>
  <img
    src="/brand/sierra-mark.png"
    alt=""
    width={width}
    height={height}
    decoding="async"
  />
  {wordmark && (
    <span class="logo__text">
      <span class="logo__org">S.I.E.R.R.A</span>
      {siteName && <span class="logo__app">{siteName}</span>}
    </span>
  )}
</a>

<!-- The app shell persists across deployments; its old markup must still match new CSS. -->
<style is:global>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .logo__org {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    color: var(--ink-strong);
  }
  .logo__app {
    font-family: var(--font-ui);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--brand-brass-text);
  }
</style>
