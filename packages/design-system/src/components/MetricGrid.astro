---
/**
 * MetricGrid — labelled readings or record details. `size="compact"` sets values
 * at UI size (record details); `identifiers` lists hashes or keys as pills.
 * Client code uses `metricGrid()` from lib/ui.
 */
import { toHTML } from "../lib/ssr";
import { metricGrid, type MetricGridProps } from "../lib/ui";
interface Props extends MetricGridProps {}
---

<Fragment set:html={toHTML(metricGrid(Astro.props))} />
