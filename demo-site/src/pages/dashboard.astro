---
/**
 * Dashboard pattern: a reference composition built only from design-system
 * components. The server renders every panel; the client script then binds
 * regions to a URL-state store so filters, selection, location and unit update
 * in place and are shareable. Synthetic data only.
 */
import DemoLayout from "../layouts/DemoLayout.astro";
import Badge from "@sierragridteam/design-system/components/Badge.astro";
import Card from "@sierragridteam/design-system/components/Card.astro";
import ChoiceTiles from "@sierragridteam/design-system/components/ChoiceTiles.astro";
import DataDiff from "@sierragridteam/design-system/components/DataDiff.astro";
import FeedItem from "@sierragridteam/design-system/components/FeedItem.astro";
import GeoJSONMap from "@sierragridteam/design-system/components/GeoJSONMap.astro";
import LineChart from "@sierragridteam/design-system/components/LineChart.astro";
import MoreLink from "@sierragridteam/design-system/components/MoreLink.astro";
import SegmentedControl from "@sierragridteam/design-system/components/SegmentedControl.astro";
import Sparkline from "@sierragridteam/design-system/components/Sparkline.astro";
import SummaryBanner from "@sierragridteam/design-system/components/SummaryBanner.astro";
import { diffValues } from "@sierragridteam/design-system/lib/data-values";
import { CATEGORIES, REPORTS, STATIONS, forecast, label, toFeatures } from "../fixtures/dashboard";

const selected = REPORTS[0];
const station = STATIONS[0];
const severe = REPORTS.filter((r) => r.severity.tone === "alarm");
---

<DemoLayout title="Dashboard pattern" description="An overview composed from design-system panels, feed and regions." sections={[]}>
  <div class="stack dashboard">
    <SummaryBanner kicker="Ebbetts Pass corridor" meta="3 active · 2 scheduled · synthetic data" asideTitle="Worth your attention">
      {REPORTS.length} reports are active or scheduled. {severe.length} are severe.
      <ul slot="aside">
        {severe.map((r) => (
          <li><Badge tone="alarm">Severe</Badge><a href={`?report=${r.id}`}>{r.title}</a></li>
        ))}
      </ul>
    </SummaryBanner>

    <div class="stats">
      <div class="stat">
        <span class="stat__label">Active reports</span>
        <span class="stat__value">3</span>
        <Sparkline label="Active reports, last 7 days" values={[1, 1, 2, 4, 5, 3, 3]} decimals={0} variant="bar" />
      </div>
      <div class="stat">
        <span class="stat__label">Mesh nodes reporting</span>
        <span class="stat__value">11 of 12</span>
        <Sparkline label="Nodes reporting, last 24 hours" values={[12, 12, 11, 12, 12, 11, 11, 11]} decimals={0} color="pine" />
      </div>
      <div class="stat">
        <span class="stat__label">Temperature, Arnold</span>
        <span class="stat__value">{station.now}°F</span>
        <Sparkline label="Temperature, last 24 hours" values={forecast(station).map((p) => p.value)} unit="°F" decimals={0} color="manzanita" />
      </div>
    </div>

    <section aria-labelledby="reports-title">
      <div class="section-header">
        <h2 id="reports-title">Reports</h2>
        <MoreLink href="#reports-title" text="Browse all reports" />
        <p>Newest first, most severe at the top. Choose a report to see what changed.</p>
      </div>
      <div class="columns columns--wide-narrow">
        <div id="feed-region" class="dashboard__feed">
          <SegmentedControl label="Category" name="category" options={[...CATEGORIES]} value="all" />
          <div class="feed">
            {REPORTS.map((r, i) => (
              <FeedItem {...r} tags={[label(r.category), r.status]} href={`?report=${r.id}`} lead={i === 0} selected={r.id === selected.id} />
            ))}
          </div>
        </div>
        <div id="detail-region">
          <Card variant="panel" kicker="Selected report" title={selected.title} source={selected.source}>
            <p class="meta">{selected.place}</p>
            <DataDiff label="Latest revision" changes={diffValues(selected.previous, selected.current)} />
          </Card>
        </div>
      </div>
    </section>

    <div class="columns columns--wide-narrow">
      <Card variant="panel" kicker="On the ground" title="Where reports are" source="Markers locate source reports; they do not mark closure extents.">
        <MoreLink slot="actions" href="#reports-title" text="Explore roads" />
        <GeoJSONMap slot="media" id="report-map" data={toFeatures(REPORTS)} label="Report locations" basemap selectable={false} />
        <p class="meta">Choose a report in the list to highlight it here.</p>
      </Card>

      <Card variant="panel" kicker="Looking ahead" title="Weather" source="Synthetic forecast. Temperatures vary across the region.">
        <MoreLink slot="actions" href="/charts" text="Forecast" />
        <div id="weather-region" class="dashboard__weather">
          <div class="dashboard__now">
            <span class="stat__value">{station.now}°F</span>
            <SegmentedControl label="Temperature unit" name="unit" options={[{ value: "f", label: "°F" }, { value: "c", label: "°C" }]} value="f" />
          </div>
          <LineChart label={`Next 24 hours, ${station.label}`} series={[{ id: "temp", label: "Temperature", color: "manzanita", area: true, points: forecast(station) }]} unit="°F" decimals={0} height={180} />
          <ChoiceTiles label="Reporting location" showLabel name="station" size="compact" value={station.value}
            options={STATIONS.map((s) => ({ value: s.value, label: s.label, detail: `${s.now}°F` }))} />
        </div>
      </Card>
    </div>
  </div>
</DemoLayout>

<script>
  import { definePage, urlState } from "@sierragridteam/design-system/lib/app";
  import { param } from "@sierragridteam/design-system/lib/url-state";
  import { region } from "@sierragridteam/design-system/lib/region";
  import { html, repeat } from "@sierragridteam/design-system/lib/template";
  import { badge, card, choiceTiles, feedItem, segmented } from "@sierragridteam/design-system/lib/ui";
  import { defineDataDiff } from "@sierragridteam/design-system/lib/data-diff";
  import { defineChartElements, type LineChartElement } from "@sierragridteam/design-system/lib/charts";
  import type { SierraGeoMap } from "@sierragridteam/design-system/lib/geo-map";
  import { diffValues } from "@sierragridteam/design-system/lib/data-values";
  import { CATEGORIES, REPORTS, STATIONS, forecast, label, toCelsius } from "../fixtures/dashboard";

  defineDataDiff();
  defineChartElements();

  definePage("/dashboard", ({ root, signal }) => {
    // Everything the view depends on lives in the URL, so any state is a shareable link.
    const state = urlState(
      {
        category: param.oneOf(CATEGORIES.map((c) => c.value), "all"),
        report: param.string(REPORTS[0].id),
        station: param.oneOf(STATIONS.map((s) => s.value), STATIONS[0].value),
        unit: param.oneOf(["f", "c"] as const, "f"),
      },
      { signal },
    );
    type S = ReturnType<typeof state.get>;
    const visible = (s: S) => REPORTS.filter((r) => s.category === "all" || r.category === s.category);
    const current = (s: S) => REPORTS.find((r) => r.id === s.report) ?? REPORTS[0];

    // Feed: a keyed list. Filtering reuses the remaining rows instead of rebuilding them.
    const feed = root.querySelector<HTMLElement>("#feed-region")!;
    region(feed, state, (s) => html`
      ${segmented({ label: "Category", name: "category", options: [...CATEGORIES], value: s.category, onChange: (category) => state.set({ category: category as S["category"] }) })}
      <div class="feed" aria-live="polite">
        ${repeat(visible(s), (r) => r.id, (r, i) =>
          feedItem({ ...r, tags: [label(r.category), r.status], href: state.href({ report: r.id }), lead: i === 0, selected: r.id === s.report }))}
      </div>`, { signal });
    feed.addEventListener("click", (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>(".feed-item__title a");
      if (!link) return;
      event.preventDefault();
      state.set({ report: new URL(link.href).searchParams.get("report")! });
    }, { signal });

    // Detail: the card re-renders around a DataDiff element that receives new props in place.
    region(root.querySelector<HTMLElement>("#detail-region")!, state, (s) => {
      const r = current(s);
      return card(
        { variant: "panel", kicker: "Selected report", title: r.title, source: r.source, actions: badge(r.severity.label, { tone: r.severity.tone }) },
        html`<p class="meta">${r.place}</p>
          <sierra-data-diff .props=${{ label: "Latest revision", changes: diffValues(r.previous, r.current) }}></sierra-data-diff>`,
      );
    }, { signal });

    // Map: an element outside any region, driven by its setter, reporting back by event.
    const map = root.querySelector<SierraGeoMap>("#report-map")!;
    const syncMap = (s: S) => (map.selected = REPORTS.findIndex((r) => r.id === s.report));
    syncMap(state.get());
    state.subscribe(syncMap, { signal });

    // Weather: unit and location re-render the panel body; the chart updates in place.
    region(root.querySelector<HTMLElement>("#weather-region")!, state, (s) => {
      const station = STATIONS.find((x) => x.value === s.station)!;
      const t = (f: number) => (s.unit === "c" ? toCelsius(f) : f);
      const unit = s.unit === "c" ? "°C" : "°F";
      const chart: LineChartElement["props"] = {
        label: `Next 24 hours, ${station.label}`,
        series: [{ id: "temp", label: "Temperature", color: "manzanita", area: true, points: forecast(station).map((p) => ({ ...p, value: t(p.value) })) }],
        unit,
        decimals: 0,
        height: 180,
      };
      return html`
        <div class="dashboard__now">
          <span class="stat__value">${t(station.now)}${unit}</span>
          ${segmented({ label: "Temperature unit", name: "unit", options: [{ value: "f", label: "°F" }, { value: "c", label: "°C" }], value: s.unit, onChange: (unit) => state.set({ unit: unit as S["unit"] }) })}
        </div>
        <sierra-line-chart class="ds-chart" .props=${chart}></sierra-line-chart>
        ${choiceTiles({ label: "Reporting location", showLabel: true, name: "station", size: "compact", value: s.station,
          options: STATIONS.map((x) => ({ value: x.value, label: x.label, detail: `${t(x.now)}${unit}` })),
          onChange: (station) => state.set({ station: station as S["station"] }) })}`;
    }, { signal });
  });
</script>

<style>
  .dashboard {
    --section-gap: var(--space-8);
  }
  .dashboard__feed {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }
  .dashboard__weather {
    display: grid;
    gap: var(--space-4);
  }
  .dashboard__now {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
</style>
