---
// Test fixture: client-built elements and server/client template parity. Not linked from the demo.
import DemoLayout from "../../layouts/DemoLayout.astro";
import FeedItem from "@sierragridteam/design-system/components/FeedItem.astro";
import SegmentedControl from "@sierragridteam/design-system/components/SegmentedControl.astro";
import ChoiceTiles from "@sierragridteam/design-system/components/ChoiceTiles.astro";
import DataDiff from "@sierragridteam/design-system/components/DataDiff.astro";
import Select from "@sierragridteam/design-system/components/Select.astro";
import Field from "@sierragridteam/design-system/components/Field.astro";
import MetricGrid from "@sierragridteam/design-system/components/MetricGrid.astro";
import MessageSign from "@sierragridteam/design-system/components/MessageSign.astro";
import RecordHeader from "@sierragridteam/design-system/components/RecordHeader.astro";
import Stat from "@sierragridteam/design-system/components/Stat.astro";
import PropertyList from "@sierragridteam/design-system/components/PropertyList.astro";
import { PARITY } from "../../fixtures/parity";
---

<DemoLayout title="Element fixtures" sections={[]}>
  <h1>Element fixtures</h1>
  <div id="server-feed"><FeedItem {...PARITY.feed} /></div>
  <div id="server-segmented"><SegmentedControl {...PARITY.segmented} /></div>
  <div id="server-tiles"><ChoiceTiles {...PARITY.tiles} /></div>
  <div id="server-diff"><DataDiff {...PARITY.diff} /></div>
  <div id="server-metrics"><MetricGrid {...PARITY.metrics} /></div>
  <div id="server-sign"><MessageSign {...PARITY.sign} /></div>
  <div id="server-header"><RecordHeader {...PARITY.header} /></div>
  <div id="server-stat"><Stat {...PARITY.stat} /></div>
  <div id="server-properties"><PropertyList {...PARITY.properties} /></div>
  <Field label="Server station" for="server-select"><Select id="server-select" {...PARITY.select} /></Field>
  <div id="client"></div>
</DemoLayout>

<script>
  import { createStore, region, renderInto } from "@sierragridteam/design-system/lib/region";
  import { html, repeat } from "@sierragridteam/design-system/lib/template";
  import { choiceTiles, feedItem, segmented, metricGrid, messageSign, recordHeader, stat, propertyList } from "@sierragridteam/design-system/lib/ui";
  import { createSelect } from "@sierragridteam/design-system/lib/select";
  import { createDataDiff } from "@sierragridteam/design-system/lib/data-diff";
  import { createLineChart } from "@sierragridteam/design-system/lib/charts";
  import { PARITY } from "../../fixtures/parity";

  const client = document.querySelector<HTMLElement>("#client")!;
  renderInto(client, html`
    <div id="client-feed">${feedItem(PARITY.feed)}</div>
    <div id="client-segmented">${segmented({ ...PARITY.segmented, name: `${PARITY.segmented.name}-client` })}</div>
    <div id="client-tiles">${choiceTiles({ ...PARITY.tiles, name: `${PARITY.tiles.name}-client` })}</div>
    <div id="client-metrics">${metricGrid(PARITY.metrics)}</div>
    <div id="client-sign">${messageSign(PARITY.sign)}</div>
    <div id="client-header">${recordHeader(PARITY.header)}</div>
    <div id="client-stat">${stat(PARITY.stat)}</div>
    <div id="client-properties">${propertyList(PARITY.properties)}</div>`);
  const select = createSelect({ id: "client-select", ...PARITY.select });
  const diff = createDataDiff(PARITY.diff);
  diff.id = "client-diff";
  const chart = createLineChart(
    { label: "Client chart", unit: "V", series: [{ id: "a", label: "A", points: [{ time: Date.UTC(2026, 10, 9, 20), value: 3.7 }, { time: Date.UTC(2026, 10, 9, 21), value: 3.8 }] }] },
    { id: "client-chart" },
  );
  client.append(select, diff, chart);

  // Regression fixtures from the 0.8 review.
  const T0 = Date.UTC(2026, 10, 9, 20);
  const points = (v: number) => [{ time: T0, value: v }, { time: T0 + 3_600_000, value: v + 1 }];

  // Props set before the element is defined (module imported lazily below).
  const early = document.createElement("sierra-sparkline") as HTMLElement & { props: unknown };
  early.id = "early-spark";
  early.props = { label: "Early", values: [1, 2, 3] };
  client.append(early);

  // Appended first, props afterwards.
  const late = document.createElement("sierra-data-diff") as HTMLElement & { props: unknown };
  late.id = "late-diff";
  client.append(late);
  late.props = { label: "Late", changes: [{ path: "/a", kind: "changed", before: 1, after: 2 }] };

  // A region disposed and created again on the same container.
  const reusedHost = document.createElement("div");
  reusedHost.id = "reused";
  client.append(reusedHost);
  const first = createStore({ text: "first" });
  region(reusedHost, first, (s) => html`<p>${s.text}</p>`).dispose();
  const second = createStore({ text: "second" });
  region(reusedHost, second, (s) => html`<p>${s.text}</p>`);
  (window as any).reusedStore = second;

  // Keyed moves keep element instances (chart state survives reordering).
  const movedHost = document.createElement("div");
  movedHost.id = "moved";
  client.append(movedHost);
  const order = createStore({ ids: ["a", "b"] });
  region(movedHost, order, (s) => html`${repeat(s.ids, (id) => id, (id) =>
    html`<sierra-line-chart data-id=${id} .props=${{ label: `Chart ${id}`, series: [{ id, label: id, points: points(id === "a" ? 1 : 5) }] }}></sierra-line-chart>`)}`);
  (window as any).moveStore = order;

  // A throwing subscriber does not starve the others.
  const noisy = createStore({ n: 0 });
  noisy.subscribe(() => {
    throw new Error("listener failure (expected in tests)");
  });
  const counter = document.createElement("output");
  counter.id = "counter";
  client.append(counter);
  noisy.subscribe((s) => (counter.textContent = String(s.n)));
  (window as any).noisyStore = noisy;

  await import("@sierragridteam/design-system/lib/sparkline").then((m) => m.defineSparkline());
  document.documentElement.dataset.fixturesReady = "";
</script>
