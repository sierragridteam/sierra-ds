---
import ValueTable from "@sierra/design-system/components/ValueTable.astro";
import MetricGrid from "@sierra/design-system/components/MetricGrid.astro";
import IdentifierList from "@sierra/design-system/components/IdentifierList.astro";
import DataDiff from "@sierra/design-system/components/DataDiff.astro";
import Card from "@sierra/design-system/components/Card.astro";
import DemoLayout from "../layouts/DemoLayout.astro";
import PageHeader from "@sierra/design-system/components/PageHeader.astro";
import DataRow from "@sierra/design-system/components/DataRow.astro";
import DataTable from "@sierra/design-system/components/DataTable.astro";
import DataStatus from "@sierra/design-system/components/DataStatus.astro";
import Badge from "@sierra/design-system/components/Badge.astro";
import MapFrame from "@sierra/design-system/components/MapFrame.astro";
import GeoJSONMap from "@sierra/design-system/components/GeoJSONMap.astro";
import { diffValues } from "@sierra/design-system/lib/data-values";
import type { FeatureCollection, Geometry } from "geojson";
const features: FeatureCollection<Geometry | null> = {
  type: "FeatureCollection",
  features: [
    {
      type: "Feature",
      properties: {
        label: "Example incident",
        description: "Fixture only. One lane closed.",
        tone: "alarm",
      },
      geometry: { type: "Point", coordinates: [-120.55, 38.07] },
    },
    {
      type: "Feature",
      properties: {
        label: "Example corridor",
        description: "Fixture only. Road alignment is illustrative.",
      },
      geometry: {
        type: "LineString",
        coordinates: [
          [-120.6, 38.02],
          [-120.5, 38.1],
          [-120.4, 38.18],
        ],
      },
    },
    {
      type: "Feature",
      properties: {
        label: "Example area",
        description: "Fixture only. Not an official boundary.",
        tone: "brass",
      },
      geometry: {
        type: "Polygon",
        coordinates: [
          [
            [-120.45, 38.04],
            [-120.28, 38.04],
            [-120.28, 38.16],
            [-120.45, 38.16],
            [-120.45, 38.04],
          ],
        ],
      },
    },
    {
      type: "Feature",
      properties: {
        label: "Unlocated report",
        description: "Location not supplied; retained in the feature list.",
      },
      geometry: null,
    },
  ],
};
const ids = Array.from(
  { length: 12 },
  (_, i) =>
    `${(i + 1).toString(16).padStart(8, "0")}a71f049e2b38c6d05f912a8e47b03c6d19e245f8037a6b19d2e4c508`,
);
const changes = diffValues(
  {
    name: "Example relay",
    enabled: false,
    hops: 0,
    signal: { snr: 8.4, rssi: -102 },
    gateways: [ids[0]],
    note: "Previous operator note",
    optional: null,
  },
  {
    name: "Example relay",
    enabled: true,
    hops: 3,
    signal: { snr: 11.2, rssi: -94 },
    gateways: [ids[0], ids[1]],
    optional: "",
    location: { lat: 38.1, lng: -120.4 },
  },
);
---

<DemoLayout
  sections={[
    { id: "tables-title", label: "Road conditions" },
    { id: "states-title", label: "Data states" },
    { id: "sources-title", label: "Source health" },
    { id: "dense-title", label: "Dense records" },
    { id: "map-title", label: "Map treatments" },
  ]}
  title="Data and maps · Sierra design system"
  description="Fixture-based tables and map components."
>
  <div class="data-demo stack">
    <PageHeader
      title="Data and maps"
      kicker="Component laboratory"
      lead="Synthetic records for reviewing data states and geographic presentation. Not live operational data."
    />
    <section class="stack" aria-labelledby="tables-title">
      <h2 id="tables-title">Road conditions</h2>
      <DataStatus
        state="fresh"
        message="Synthetic fixture data. All road-status examples are shown below."
        updatedAt="2026-11-07T17:00:00Z"
      />
      <div id="road-results">
        <DataTable
          caption="Road conditions · sample records"
          columns={[
            { label: "Road" },
            { label: "Status" },
            { label: "Travel", numeric: true },
            { label: "Delay", numeric: true },
          ]}
        >
          <DataRow label="SR 4" description="Example west segment">
            <td>
              <Badge tone="ok">Open</Badge>
            </td>
            <td class="ds-numeric">18 min</td>
            <td class="ds-numeric">0 min</td>
          </DataRow>
          <DataRow
            label="SR 108"
            description="Example east segment"
            note="One lane available. Example advisory for this road segment."
            noteTone="caution"
          >
            <td>
              <Badge tone="elevated">Restricted</Badge>
            </td>
            <td class="ds-numeric">32 min</td>
            <td class="ds-numeric">12 min</td>
          </DataRow>
          <DataRow label="SR 49" description="Example north segment">
            <td>
              <Badge tone="alarm">Closed</Badge>
            </td>
            <td class="ds-numeric">Not available</td>
            <td class="ds-numeric">Not available</td>
          </DataRow>
        </DataTable>
      </div>
    </section>
    <section class="stack" aria-labelledby="states-title">
      <h2 id="states-title">Data-state variants</h2>
      <div class="variant-grid">
        <Card title="Loading">
          <DataStatus
            state="loading"
            message="Waiting for the first response."
          />
          <div class="skeleton skeleton--row" aria-hidden="true"></div>
        </Card>
        <Card title="Stale">
          <DataStatus
            state="stale"
            message="Refresh failed. Keep the last successful readings visible."
            updatedAt="2026-11-07T17:00:00Z"
          />
          <MetricGrid
            label="Last known travel time"
            items={[
              {
                label: "Travel",
                value: 32,
                unit: "min",
                description: "Last known reading, not current",
              },
            ]}
          />
        </Card>
        <Card title="Unavailable">
          <DataStatus
            state="unavailable"
            message="No reliable reading is available. Counts and travel times are unknown."
          />
        </Card>
        <Card title="Empty">
          <DataStatus
            state="empty"
            message="The request succeeded. No records match this query."
          />
        </Card>
      </div>
    </section>
    <section class="stack" aria-labelledby="sources-title">
      <h2 id="sources-title">Source health</h2>
      <DataTable
        caption="Source health · sample records"
        columns={[
          { label: "Source" },
          { label: "Health" },
          { label: "Last success" },
          { label: "Records", numeric: true },
        ]}
      >
        <DataRow label="Road incidents">
          <td>
            <Badge tone="ok">Fresh</Badge>
          </td>
          <td>
            <time datetime="2026-11-07T17:00:00Z">17:00 UTC</time>
          </td>
          <td class="ds-numeric">2</td>
        </DataRow>
        <DataRow
          label="Weather alerts"
          note="Showing the last known weather result. Freshness is not guaranteed."
          noteTone="caution"
        >
          <td>
            <Badge tone="elevated">Stale</Badge>
          </td>
          <td>
            <time datetime="2026-11-07T15:00:00Z">15:00 UTC</time>
          </td>
          <td class="ds-numeric">1</td>
        </DataRow>

        <DataRow label="Power outages">
          <td>
            <Badge>Unavailable</Badge>
          </td>
          <td>Unknown</td>
          <td class="ds-numeric">Unknown</td>
        </DataRow>
      </DataTable>
    </section>
    <section class="stack" aria-labelledby="dense-title">
      <h2 id="dense-title">Dense record detail</h2>
      <p class="meta">
        Synthetic examples modeled on the event-detail structure. These
        components accept domain-neutral labels and values.
      </p>
      <Card padded={false}>
        <ValueTable
          label="Record fields"
          rows={[
            {
              label: "name",
              value: "Example relay",
              description: "Human-readable name reported by the source.",
            },
            {
              label: "publicKey",
              value: ids[0],
              description:
                "Full identifier. Long values wrap without widening the page.",
            },
            {
              label: "enabled",
              value: false,
              description: "False is a known value, not missing data.",
            },
            {
              label: "hopCount",
              value: 0,
              description: "Zero represents a direct observation.",
            },
            {
              label: "description",
              value: "",
              description: "An explicitly empty string.",
            },
            {
              label: "expires",
              value: null,
              description: "Explicit null supplied by the source.",
            },
            {
              label: "lastSeen",
              missing: "Not reported",
              description: "The source did not supply this field.",
            },
          ]}
        />
      </Card>
      <h3>Gateway-reported signal</h3>
      <MetricGrid
        label="Gateway-reported signal"
        items={[
          {
            label: "SNR",
            value: 11.2,
            unit: "dB",
            description: "Gateway-reported",
          },
          {
            label: "RSSI",
            value: -94,
            unit: "dBm",
            description: "Gateway-reported",
          },
          { label: "Hops", value: 0, description: "Heard directly" },
          {
            label: "Last advert",
            value: "14:32",
            unit: "UTC",
            description: "Example observation time",
          },
        ]}
      />
      <h3>Other metric uses</h3>
      <MetricGrid
        label="Device health"
        items={[
          {
            label: "Battery",
            value: 82,
            unit: "%",
            description: "Latest device reading",
          },
          {
            label: "Temperature",
            value: 0,
            unit: "°C",
            description: "A valid zero reading",
          },
          {
            label: "Voltage",
            value: null,
            missing: "Not read",
            description: "Device did not report voltage",
          },
        ]}
      />
      <Card>
        <IdentifierList
          label="Gateway identifiers"
          values={ids}
          previewCount={4}
        />
      </Card>
      <Card>
        <IdentifierList
          label="Related records"
          values={[]}
          emptyMessage="No related identifiers were supplied."
        />
      </Card>
      <Card>
        <DataDiff
          label="Changes between observations"
          changes={[
            {
              path: "provenance.attribution",
              kind: "changed",
              before: "Example community mesh",
              after: "Example community mesh via a new gateway provider",
            },
            {
              path: "provenance.fetchedAt",
              kind: "changed",
              before: "2026-11-07T05:34:07.12113261Z",
              after: "2026-11-07T06:33:01.263357378Z",
            },
            ...changes,
          ]}
        />
      </Card>
      <Card>
        <DataDiff label="Unchanged observation" changes={[]} />
      </Card>
    </section>
    <section class="stack" aria-labelledby="map-title">
      <h2 id="map-title">Map treatments</h2>
      <MapFrame
        label="Example geographic features"
        caption="Point markers, corridor lines and translucent areas shown together. Illustrative geometry, not live conditions."
      >
        <GeoJSONMap
          data={features}
          label="Synthetic points, corridor and area"
          basemap
          selectable={false}
        />
        <div slot="legend" class="legend">
          <Badge tone="ok">Corridor</Badge>
          <Badge tone="elevated">Area</Badge>
          <Badge tone="alarm">Incident</Badge>
        </div>
        <span slot="attribution">
          Map styling follows sierragridteam.org. Features are synthetic
          fixtures.
        </span>
      </MapFrame>
    </section>
  </div>
</DemoLayout>
<style>
  .variant-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-4);
  }
  .data-demo {
    gap: var(--space-8);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .legend {
    justify-content: flex-start;
  }
</style>
