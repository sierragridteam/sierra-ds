<script>
  import { openDialog } from "@sierra/design-system/lib/dialog";
  import { toast } from "@sierra/design-system/lib/toast";
  import { el } from "@sierra/design-system/lib/dom";
  document.querySelector("#density")?.addEventListener("change", (event) => {
    const value = (event.target as HTMLButtonElement).value;
    document.querySelector<HTMLElement>(".sg__preview")!.dataset.density =
      value;
  });
  document.querySelector("#width")?.addEventListener("change", (event) => {
    document.querySelector<HTMLElement>(".sg__preview")!.dataset.width = (
      event.target as HTMLButtonElement
    ).value;
  });
  document.querySelector("#dialog-demo")?.addEventListener("click", () => {
    const dialog = openDialog({
      title: "Review changes",
      kicker: "Design system",
    });
    dialog.body.append(
      el("p", {}, "Native dialog with keyboard dismissal and focus handling."),
    );
  });
  document
    .querySelector("#toast-demo")
    ?.addEventListener("click", () => toast("Changes saved."));
</script>
